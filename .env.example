# Nothing here is needed for the demo or tests. Everything runs offline by default.
# Live modes are opt-in and refuse to run unless every guard below is set.

# PostHog: browser snippet (public project key, starts with phc_). Empty = local mode.
POSTHOG_PROJECT_API_KEY=
# PostHog: REST API (experiments / flags / query). Sandbox project only.
LPL_POSTHOG_LIVE=0
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_SANDBOX_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=

# Preview deploys (Vercel / Cloudflare Pages). Never production.
LPL_DEPLOY_LIVE=0
LPL_PROTECTED_PROJECTS=
VERCEL_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional LLM variant provider (needs allow_network=True in code too)
ANTHROPIC_API_KEY=
